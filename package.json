{
  "name": "sinbad-seven-treasures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "build": "npm run typecheck && npm run validate:content && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.3.1",
    "@types/three": "0.180.0",
    "eslint": "9.35.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
